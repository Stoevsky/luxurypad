# ——— App ———
# The canonical public URL. Its host is the ONLY domain a SIWE login message may
# claim in production — sign-in fails closed if this is unset or unparseable,
# because domain binding is what stops a signature farmed on another site being
# replayed here. In development the request host is accepted as well, so sign-in
# keeps working on whichever port `next dev` picked.
NEXT_PUBLIC_APP_URL=https://luxurypad.family

# Session signing key for SIWE sessions. Must be >= 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ——— Chain (Robinhood Chain, id 4663) ———
NEXT_PUBLIC_CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_FALLBACK_URL=
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Multicall3. Defaults to the canonical address on chain 4663, where it is
# verified deployed. Required for any other chain: without it viem cannot batch,
# one curve read becomes 19 requests, and the public RPC rate-limits page loads
# into failure. Leave blank only if the chain genuinely has no Multicall3.
NEXT_PUBLIC_MULTICALL3=

# ——— Stock Token registry ———
ASSET_API_BASE=https://api.robinhood.com/rhj

# ——— Wallets ———
# Required only for WalletConnect / mobile deep links.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ——— Supabase (schema is in supabase/migrations; not yet provisioned) ———
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ——— Optional X (Twitter) OAuth for creator verification ———
X_CLIENT_ID=
X_CLIENT_SECRET=

# ——— Pons deployment ———
# Leave both blank to use the verified Pons V2 mainnet deployment pinned in
# src/lib/pons/contracts.ts (only valid when NEXT_PUBLIC_CHAIN_ID=4663).
#
# Set them to point this instance at a different Pons deployment. They are
# consensus-critical: a wrong value silently sends funds to the wrong contract,
# so the launch preflight re-verifies chain id, factory bytecode and the pair
# allowlist on chain before it will produce a transaction.
#
# When the factory is set on a chain other than 4663, also set RPC_URL and
# NEXT_PUBLIC_RPC_URL — otherwise reads still go to Robinhood mainnet and the
# preflight fails its "Network" check.
NEXT_PUBLIC_PONS_FACTORY=
# Launch-and-buy router. Optional: without it launches still work, but a
# creator's initial buy cannot be bundled into the launch transaction.
NEXT_PUBLIC_PONS_ROUTER=

# NOTE ON LUXURY PAIR ASSETS
# Pair tokens that back a luxury house (Ferrari, LVMH, …) are mapped to a
# company id in src/lib/registry/luxury-pairs.ts, not here — the mapping is
# per-chain and must be reviewed with the code that reads it.
