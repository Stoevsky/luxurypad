# ——— App ———
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing key for SIWE sessions. Must be >= 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ——— Chain (Robinhood Chain, id 4663) ———
NEXT_PUBLIC_CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_FALLBACK_URL=
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# ——— Stock Token registry ———
ASSET_API_BASE=https://api.robinhood.com/rhj

# ——— Wallets ———
# Required only for WalletConnect / mobile deep links.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ——— Supabase (schema is in supabase/migrations; not yet provisioned) ———
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ——— Optional X (Twitter) OAuth for creator verification ———
X_CLIENT_ID=
X_CLIENT_SECRET=

# NOTE ON PONS ADDRESSES
# The Pons V2 factory, router, hook, locker and graduation executor are pinned in
# src/lib/pons/contracts.ts rather than read from the environment. They are
# consensus-critical: a wrong value silently sends funds to the wrong contract.
# Changing them requires re-verifying bytecode on chain and recording a new
# protocol version so historical launches keep resolving correctly.
